# Copy to .env and adjust. Bun loads .env automatically.

# Public URL of the tracker (used for links, cookies and OAuth callbacks)
APP_URL=http://localhost:3000
PORT=3000
DATABASE_PATH=./data/tracker.db
# Generate with: openssl rand -hex 32 (required in production)
BETTER_AUTH_SECRET=
# Set to true only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# GitHub OAuth app. Callback URL: <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email: "smtp" (default in production) or "dev" (development only: printed to the
# console and listed at /dev/mail). For Mailpit locally: SMTP_HOST=localhost SMTP_PORT=1025
# Leave empty for dev locally and smtp in production.
MAIL_TRANSPORT=
MAIL_FROM=Kaneo Feature Track <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
# Leave empty to infer true on port 465, false otherwise.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Automatic verified backups: enabled by default in production, disabled locally.
# Leave empty for defaults. Docker defaults to /data/backups (inside the data volume).
BACKUP_ENABLED=
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# Accepted requests become GitHub issues; merged PRs and releases update their status.
# Fine-grained token for this repository: Issues read/write, Contents read, Pull requests read.
GITHUB_REPO=usekaneo/kaneo
GITHUB_TOKEN=
# Added to new issues; created in the repository if it doesn't exist
GITHUB_ISSUE_LABEL=feature
# Final releases and nightly / pre-release builds, matched against release tags
GITHUB_RELEASE_TAG_PATTERN=^v\d+\.\d+\.\d+$
GITHUB_NIGHTLY_TAG_PATTERN=^(nightly.*|v\d+\.\d+\.\d+-.+)$
GITHUB_SYNC_INTERVAL_SECONDS=300

# Changelog page (/changelog): releases of this repository, split into Kaneo and MCP.
# Defaults to GITHUB_REPO; works without a token for public repositories.
CHANGELOG_REPO=
CHANGELOG_MCP_TAG_PATTERN=^mcp-v\d+\.\d+\.\d+$
# MCP releases have no notes of their own; they are built from commits under this path
CHANGELOG_MCP_PATH=packages/mcp

# Auto-label new requests and title/description edits using the Triaged Jev rubric.
# Enabled when either key is set; OpenRouter takes precedence. Set false to pause.
# Sends the title, first 12,000 description characters and area label names to the provider.
AUTO_LABEL_ENABLED=true
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
# Optional model override (defaults: typesafe/jev-1.13 on OpenRouter, jev-latest on TypeSafe)
JEV_MODEL=
# Optional project context override
AUTO_LABEL_CONTEXT=
